{
  "manifest_version": 2,
  "name": "AItero Assistant",
  "version": "0.2.0",
  "description": "A local, read-only AI assistant for the current Zotero PDF.",
  "applications": {
    "zotero": {
      "id": "aitero-assistant@local",
      "strict_min_version": "9.0",
      "strict_max_version": "9.0.*",
      "update_url": "https://example.invalid/aitero-assistant-updates.json"
    }
  }
}
